# Copy this file to `.env` (which is git-ignored) and fill in your key.
# Create keys at https://www.thesuper.market → My Profile → API Keys.
SUPERMARKET_API_KEY=ace_2611cdd0992b715c5efae4b0138c46f774b48811

# Optional settings
# SUPERMARKET_BASE_URL=https://www.thesuper.market/api/v1
# Tournament slug to use (run `python -m supermarket_bot tournaments` to list them).
# SUPERMARKET_TOURNAMENT=
# Per-account budget is shared by all your keys: standard accounts get
# 100 reads and 30 writes per minute. The bot stays a little under that.
# SUPERMARKET_READS_PER_MIN=90
# SUPERMARKET_WRITES_PER_MIN=25
# SUPERMARKET_DATA_DIR=data
